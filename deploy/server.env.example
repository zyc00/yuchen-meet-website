NODE_ENV=production
PORT=8318
DATABASE_PATH=/var/lib/yuchen-meeting/booking.sqlite
SITE_ORIGIN=https://meet.yuchenzh.com
API_ORIGIN=https://meet-api.yuchenzh.com
ADMIN_USERNAME=yuchen
# SHA-256 hex digest of a separately generated random administrator password.
ADMIN_PASSWORD_HASH=
# 32 random bytes, encoded as 64 hex characters. Keep this key with database backups.
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://meet-api.yuchenzh.com/api/google/callback
MEETING_URL=https://example.com/your-meeting-link
