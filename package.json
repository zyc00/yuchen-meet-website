    "test": "node --test tests/*.test.mjs server/tests/*.test.mjs",
    "start": "node --env-file=.env.server server/index.mjs"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "oauth4webapi": "3.8.8"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "@types/node": "22.19.19"
  }
}
